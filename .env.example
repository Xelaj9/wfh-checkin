# ===== Supabase =====
# จาก Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — ใช้เฉพาะฝั่ง server เท่านั้น (ห้าม prefix NEXT_PUBLIC_)
# ใช้สำหรับ insert audit log / เขียน attendance ที่ต้อง bypass RLS อย่างปลอดภัย
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== App =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Timezone หลักของบริษัท (ใช้คำนวณ "วันนี้" / มาสาย)
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Bangkok

# Secret สำหรับป้องกัน endpoint cron (/api/cron/*)
# บน Vercel: ตั้ง env นี้แล้ว Vercel Cron จะแนบ Authorization: Bearer <CRON_SECRET> ให้อัตโนมัติ
CRON_SECRET=change-me-to-a-long-random-string

# เปิดฟอร์ม dev login (email/password) สำหรับทดสอบ local โดยไม่ต้องตั้ง Google OAuth
# ⚠️ ห้ามตั้งเป็น true บน production
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true
